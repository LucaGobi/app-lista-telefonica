<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="5dp"
    tools:context=".DetalhesActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20sp"
        android:gravity="center"
        android:text="Detalhes do contato"
        android:textColor="#000000"
        android:textSize="35sp" />

    <EditText
        android:id="@+id/detalheNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40sp"
        android:layout_marginTop="15sp"
        android:layout_marginRight="40sp"
        android:hint="Nome"
        android:inputType="text" />

    <EditText
        android:id="@+id/detalheEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40sp"
        android:layout_marginTop="15sp"
        android:layout_marginRight="40sp"
        android:hint="Endereço"
        android:inputType="text" />

    <EditText
        android:id="@+id/detalheTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40sp"
        android:layout_marginTop="15sp"
        android:layout_marginRight="40sp"
        android:hint="Telefone"
        android:inputType="phone" />

    <EditText
        android:id="@+id/detalheEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40sp"
        android:layout_marginTop="15sp"
        android:layout_marginRight="40sp"
        android:hint="Email"
        android:inputType="textEmailAddress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/editar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20sp"
            android:layout_marginRight="5sp"
            android:text="editar" />

        <Button
            android:id="@+id/deletar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5sp"
            android:layout_marginVertical="20sp"
            android:text="deletar" />

        <Button
            android:id="@+id/detalheCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20sp"
            android:layout_marginLeft="5sp"
            android:text="cancelar" />

    </LinearLayout>

</LinearLayout>